# Environment Variables Template for Database & Spring Boot
# Copy this file to .env and configure your credentials

SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/school_management_db
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000
